        <mxCell id="c16" value="&lt;b&gt;7. Actuation Layer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:10px&quot;&gt;Tindakan fisik&lt;br&gt;(Tahap 4)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="835" width="190" height="85" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;Sensor Tier 1 (per kolam)&lt;/b&gt;&lt;br&gt;DO/TEMP · pH · ORP · TAN · EC/Salinitas&lt;br&gt;Turbidity · Chlorophyll-a · Water Level · Vibrasi Aerator&lt;br&gt;&lt;i&gt;9 sensor × 10 kolam = 90 node&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=11;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="87" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Sensor Tier 2 (bersama)&lt;/b&gt;&lt;br&gt;Barometric Pressure + Solar Radiation&lt;br&gt;&lt;i&gt;2 node, 1 tiang per site&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=11;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="92" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="c19" value="Semua sensor: &lt;b&gt;RS485 Modbus RTU&lt;/b&gt;&lt;br&gt;1 unit-load per node&lt;br&gt;Total &lt;b&gt;92 node&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="92" width="230" height="70" as="geometry"/></mxCell>
