        <mxCell id="c12" value="&lt;b&gt;5. Backend Layer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:10px&quot;&gt;Terima, simpan, proses&lt;br&gt;(Tahap 2 &amp;amp; 5)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="585" width="190" height="85" as="geometry"/></mxCell>
