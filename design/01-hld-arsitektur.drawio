        <mxCell id="c1" value="SmartAqua Pond — High-Level Design (7 Layer)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="35" as="geometry"/></mxCell>
        <mxCell id="c2" value="Alur end-to-end dari sensor di kolam sampai aerator/pompa. Garis putus-putus = komponen yang belum dibangun (Tahap 2–5)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1100" height="22" as="geometry"/></mxCell>
        <mxCell id="c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="1200" height="105" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;1. Field Layer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:10px&quot;&gt;Akuisisi data fisik&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="190" height="85" as="geometry"/></mxCell>
        <mxCell id="c5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1200" height="105" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;2. Connectivity Layer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:10px&quot;&gt;Salurkan data ke edge&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="210" width="190" height="85" as="geometry"/></mxCell>
        <mxCell id="c7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=6;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="325" width="1200" height="105" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;3. Edge Layer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:10px&quot;&gt;Polling, buffer, publish&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="335" width="190" height="85" as="geometry"/></mxCell>
        <mxCell id="c9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1200" height="105" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;4. Transport Layer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:10px&quot;&gt;Site ↔ internet/cloud&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="190" height="85" as="geometry"/></mxCell>
